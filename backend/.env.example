# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.
# 값이 없으면 application.yml 의 로컬 개발용 기본값(beanote/beanote)을 사용한다.
DB_URL=jdbc:mysql://localhost:3306/beanote?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=beanote
DB_PASSWORD=beanote

# 32바이트 이상 임의 문자열. 예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
